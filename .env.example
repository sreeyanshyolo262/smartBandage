# Copy this file to .env and fill in your key.
# The app auto-loads .env on startup (see app.py) -- no extra package needed.

SECRET_KEY=change-this-to-any-random-string

# Chat uses Groq. Without a key the app still runs and the chat says the key is missing.
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b
